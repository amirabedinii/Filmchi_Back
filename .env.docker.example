# Filmchi Docker Environment
# Copy to .env and fill in your values: cp .env.docker.example .env

# Required - JWT secrets (min 16 chars)
JWT_SECRET=your-super-secret-jwt-key-min-16-chars
REFRESH_JWT_SECRET=your-super-secret-refresh-key-min-16-chars

# Database (used by docker-compose)
POSTGRES_USER=filmchi
POSTGRES_PASSWORD=filmchi
POSTGRES_DB=filmchi
POSTGRES_PORT=5432

# Redis (optional password)
REDIS_PASSWORD=
REDIS_PORT=6379

# pgAdmin
PGADMIN_EMAIL=admin@filmchi.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# App
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Optional - TMDB API (for movie metadata)
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# Optional - LLM for recommendations
LLM_PRIMARY_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
